# Copy to .env and fill in values for your SMUS environment.
AWS_REGION=us-west-2

# DataZone / SageMaker Unified Studio domain id (starts with dzd_)
DZ_DOMAIN_ID=dzd_xxxxxxxxxxxxxx

# SMUS project name (the script will look up the project id by this name)
DZ_PROJECT_NAME=SMUS-Demo

# Glue database name created by the project's LakeHouseDatabase environment.
# In the portal: SMUS-Demo project -> Environments -> LakeHouseDatabase -> glueDBName.
GLUE_DATABASE=glue_db_xxxxxxxxxxx

# Project's managed S3 bucket (the "AmazonSagemaker..." bucket).
# In the portal: SMUS-Demo project -> Environments -> LakeHouseDatabase -> glueOutputUri (root).
PROJECT_BUCKET=amazon-sagemaker-<account>-<region>-<suffix>

# (Optional) override the demo bucket; defaults to smus-catalog-demo-<account>-<region>
# DEMO_BUCKET=

# Project user execution role ARN (datazone_usr_role_<projectId>_<envId>)
# Required only for scripts/08_run_training_job.py
# PROJECT_EXECUTION_ROLE=arn:aws:iam::<account>:role/datazone_usr_role_xxx_yyy
