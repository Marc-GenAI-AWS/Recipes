# copy to .env and fill in; every value is also settable directly in pipeline/config.py
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012
SAGEMAKER_BUCKET=sagemaker-us-west-2-123456789012
SAGEMAKER_ROLE=arn:aws:iam::123456789012:role/service-role/AmazonSageMaker-ExecutionRole-00000000T000000
S3_PREFIX=scene-specialists
TRAINER_IMAGE_REPO=scene-specialist-trainer

# the teacher that writes the training data — a Bedrock model id, or leave the id and set
# TEACHER_ENDPOINT to an OpenAI-compatible /v1 to serve a large open model on your own GPUs instead
TEACHER_MODEL=us.anthropic.claude-fable-5-1
TEACHER_ENDPOINT=

# the brief-adherence judge (vision). Set JUDGE_ENDPOINT to run a served vision model at no per-call cost
JUDGE_MODEL=us.anthropic.claude-opus-5
JUDGE_ENDPOINT=

# base models the specialists are fine-tuned from
BASE_MODEL=Qwen/Qwen3-8B
BASE_MODEL_LARGE=Qwen/Qwen3.8-27B

# headless render concurrency — raise to your vCPU count; this dominates wall-clock, not GPU time
RENDER_SLOTS=4
