# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Source it before running any script or CDK command:
#   source .env
#
# All parameters here are read by config.py, which is imported by every
# script in this repo.  Change a value here and it propagates to CDK stack
# deployments, data-prep jobs, and training job launches automatically.
#
# .env is listed in .gitignore — do NOT commit it to source control.

# ── AWS ─────────────────────────────────────────────────────────────────────────

# AWS region for all resources (VPC, FSx, SageMaker training jobs, ECR).
export AWS_REGION=us-west-2

# Your AWS account ID (12 digits).
# Find it with: aws sts get-caller-identity --query Account --output text
export AWS_ACCOUNT_ID=123456789012

# ── Availability zones ──────────────────────────────────────────────────────────
#
# The core of this architecture: FSx Lustre lives in FSX_AZ, SageMaker training
# runs in SAGEMAKER_AZ.  Setting them to different AZs within the same region
# validates that cross-AZ Lustre reads don't bottleneck training throughput.
#
# Rules:
#   - Both must be in AWS_REGION (e.g. us-west-2a, not eu-west-1a).
#   - Set them to different AZs to exercise the cross-AZ design.
#     Same-AZ works but defeats the validation purpose.
#   - GPU capacity (P4d, P4de, P5) is often constrained to one or two AZs.
#     Check capacity with: scripts/check-az-capacity.sh before committing.

# AZ where the FSx for Lustre filesystem is created.
# Your genomic data (FASTA files, preprocessed .bin/.idx) lives here.
export FSX_AZ=us-west-2a

# AZ where SageMaker training jobs run.
# Choose an AZ with GPU capacity for your chosen instance type.
export SAGEMAKER_AZ=us-west-2c

# ── Network ─────────────────────────────────────────────────────────────────────

# VPC CIDR block.  Change only if 10.0.0.0/16 conflicts with existing VPCs
# in your account (CDK will reject a duplicate CIDR).
export VPC_CIDR=10.0.0.0/16

# ── FSx for Lustre ──────────────────────────────────────────────────────────────

# Filesystem size in GiB.  Must be a multiple of 1200.
#   1200  — minimum, good for validation (holds ~10–100 GB of genomic data)
#   4800  — medium, suitable for 1–2 TB datasets
#   9600  — large, for multi-TB production workloads
export LUSTRE_STORAGE_GB=1200

# Deployment type.
#   SCRATCH_2    — ephemeral, no replication, cheapest.  Good for validation.
#   PERSISTENT_2 — durable, replicated within AZ.  Use for production data
#                  you don't want to re-stage after a filesystem deletion.
export LUSTRE_DEPLOYMENT_TYPE=SCRATCH_2

# ── BioNeMo container ───────────────────────────────────────────────────────────

# Full ECR URI of your mirrored BioNeMo container.
# See README.md -> "Mirror the BioNeMo container to your ECR" for the one-time
# setup step.  After mirroring, set this to the URI of your private copy.
#
# Format: <account_id>.dkr.ecr.<region>.amazonaws.com/<repo>:<tag>
export BIONEMO_IMAGE=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/bionemo-framework:2.7.1

# ── CDK stack name overrides (optional) ─────────────────────────────────────────
# Uncomment and change these to deploy multiple isolated environments
# (e.g. dev / staging / prod) into the same account without collisions.

# export NETWORK_STACK=CrossAzFsxNetwork
# export IAM_STACK=CrossAzFsxIam
# export LUSTRE_STACK=CrossAzFsxLustre

# ── NOT STORED HERE: NGC API key ────────────────────────────────────────────────
#
# The NGC API key is used exactly once, during the one-time BioNeMo container
# mirror step.  After that it lives in ~/.docker/config.json (via
# `docker login nvcr.io`) and scripts read it from there automatically.
#
# Do NOT put your NGC key in this file.  See README.md -> "NGC API key setup".
